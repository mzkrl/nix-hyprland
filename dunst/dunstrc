# ==========================================
# DUNST CONFIG — Notifications
# Color Scheme: Anthropic Brand
# ==========================================

[global]
    ### Display ###
    monitor = 0
    follow  = mouse

    ### Geometry ###
    width        = 340
    height       = 200
    origin       = top-right
    offset       = 12x48          # Jarak dari pojok (pas di bawah waybar)
    scale        = 0
    notification_limit = 5

    ### Progress bar ###
    progress_bar                  = true
    progress_bar_height           = 8
    progress_bar_frame_width      = 1
    progress_bar_min_width        = 150
    progress_bar_max_width        = 300
    progress_bar_corner_radius    = 4
    progress_bar_corners          = all

    ### Look & Feel ###
    transparency     = 10
    separator_height = 2
    padding          = 12
    horizontal_padding = 14
    text_icon_padding = 8
    frame_width      = 2
    frame_color      = "#d97757"      # Orange border
    gap_size         = 6
    separator_color  = frame
    sort             = yes
    corner_radius    = 10

    ### Text ###
    font         = Poppins 11
    line_height  = 4
    markup       = full
    format       = "<b>%s</b>\n%b"
    alignment    = left
    vertical_alignment = center
    word_wrap    = yes
    ellipsize    = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes

    ### Icons ###
    enable_recursive_icon_lookup = true
    icon_theme   = Adwaita
    icon_position = left
    min_icon_size = 32
    max_icon_size = 48
    icon_path    = /usr/share/icons/Adwaita/48x48/status/:/usr/share/icons/Adwaita/48x48/devices/:/usr/share/icons/Adwaita/48x48/apps/

    ### History ###
    sticky_history  = yes
    history_length  = 20

    ### Misc ###
    dmenu            = wofi --dmenu -p dunst
    browser          = firefox --new-tab
    always_run_script = true
    title            = Dunst
    class            = Dunst
    ignore_dbusclose = false
    force_xwayland   = false
    force_xinerama   = false
    mouse_left_click   = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click  = close_all

# ─── Urgency: Low ────────────────────────────────
[urgency_low]
    background   = "#141413"          # Brand Dark
    foreground   = "#b0aea5"          # Mid Gray
    frame_color  = "#595959"
    timeout      = 4
    icon         = dialog-information

# ─── Urgency: Normal ─────────────────────────────
[urgency_normal]
    background   = "#141413"          # Brand Dark
    foreground   = "#faf9f5"          # Brand Light
    frame_color  = "#d97757"          # Orange accent
    timeout      = 6
    icon         = dialog-information

# ─── Urgency: Critical ───────────────────────────
[urgency_critical]
    background   = "#1a0e0a"          # Dark reddish
    foreground   = "#faf9f5"
    frame_color  = "#d97757"          # Orange accent
    timeout      = 0                  # Gak ilang sampai diklik
    icon         = dialog-warning

# ─── Screenshot notifikasi ───────────────────────
[screenshot]
    summary = "Screenshot*"
    background = "#141413"
    foreground = "#788c5d"            # Green accent
    frame_color = "#788c5d"
    timeout = 3

# ─── Volume notifikasi ───────────────────────────
[volume]
    summary = "Volume*"
    background = "#141413"
    foreground = "#6a9bcc"            # Blue accent
    frame_color = "#6a9bcc"
    timeout = 2
